# --- Local (Docker Postgres) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cupcake_shop?schema=public"
# Mesma URL no local; no Neon use a conexão "direct" (sem pooler) para migrations.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cupcake_shop?schema=public"

# URL pública do site (SEO, Open Graph). Em produção: https://seu-projeto.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3456"

# Senha do painel admin (mín. 12 caracteres; não use placeholders).
ADMIN_PASSWORD=""

# Segredo para assinar cookie de sessão admin (mín. 16 caracteres aleatórios).
ADMIN_SESSION_SECRET=""

# --- Neon (produção na Vercel) ---
# DATABASE_URL = connection string com pooler (?sslmode=require, host ...-pooler...)
# DIRECT_URL   = connection string direct (sem -pooler) — obrigatória no build (migrate deploy)
# Gere ADMIN_PASSWORD e ADMIN_SESSION_SECRET fortes (ex.: openssl rand -base64 24)
