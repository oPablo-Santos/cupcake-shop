# Local (Docker): use postgres://...localhost/cupcake_shop
# Neon (neon init): preenche DATABASE_URL (pooler), DATABASE_URL_UNPOOLED e DIRECT_URL (= unpooled, Prisma migrate)
DATABASE_URL=
DIRECT_URL=
DATABASE_URL_UNPOOLED=

NEXT_PUBLIC_SITE_URL="http://localhost:3456"
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Opcional: usuário do admin criado no bootstrap (padrão: admin)
ADMIN_USERNAME=

# Opcional (Neon CLI): NEON_BRANCH, NEON_BRANCH_ID, NEON_FUNCTION_HOST_SUFFIX
