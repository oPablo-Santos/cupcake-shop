    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.7",
    "jest": "^29.7.0",
    "prisma": "^6.16.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.0",
